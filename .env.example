# Copy this file to .env and configure
PORT=5000
MODEL_URL=https://github.com/gkumarg/ChessClassifier/releases/download/v0.1/export.pkl
# SHA-256 of the model at MODEL_URL; the server refuses to load a model that does not match
MODEL_SHA256=4c377e71a4dee21f6ea2732967e783eab708f59fb4e749a1f81818f60f22c80d
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com
MAX_FILE_SIZE_MB=10
RATE_LIMIT_PER_MINUTE=30
# Behind a reverse proxy, set to the proxy's IP(s) (or *) so rate limiting sees real client IPs
# FORWARDED_ALLOW_IPS=*
